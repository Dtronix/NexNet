{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "emitDeclarationOnly": false,
    "rootDir": ".",
    "types": [
      "node"
    ],
    "paths": {
      "@dtronix/nexnet": [
        "./packages/nexnet/src/index.js"
      ],
      "@dtronix/nexnet/node": [
        "./packages/nexnet/src/node.js"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.js",
    "packages/*/test/**/*.js",
    "*.config.js"
  ]
}
