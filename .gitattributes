# Line endings for files whose consumers require a specific form, regardless of core.autocrlf.
# No global "* text=auto" here: src/.gitattributes covers src/, and a repo-wide default would renormalize everything.

# Shell scripts and the Gradle wrapper run under bash, which rejects CRLF.
*.sh      text eol=lf
gradlew   text eol=lf

# JSON (golden vectors, IR snapshots) is compared byte-for-byte.
*.json    text eol=lf

# Golden vectors (JSON Lines) and fuzz corpus hex, read by the Java and JS clients too.
*.jsonl                          text eol=lf
src/NexNet.Fuzz/Corpus/*.hex     text eol=lf

# Generator test snapshots: NEXNET_UPDATE_SNAPSHOTS=1 writes LF, so check out LF to avoid CRLF churn.
src/NexNet.Generator.Tests/**/Snapshots/*     text eol=lf

# Windows batch files need CRLF.
*.bat     text eol=crlf
*.cmd     text eol=crlf
