<Project Sdk="Microsoft.NET.Sdk">
  <!-- The NexNet Inspector desktop app (Avalonia). Native AOT on win-x64 and linux-x64: compiled bindings only, no
       reflection. The headless self-check is what CI runs against each published binary. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>nexnet-inspector</AssemblyName>
    <RootNamespace>NexNet.Inspector.App</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Platform/SystemMotion's [LibraryImport] generates a pinned 'ref' marshaller, which is unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NexNet.Inspector.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <!-- The headless switch runs the self-check on Avalonia's headless platform (drawn by Avalonia.Skia, which Desktop brings),
         so a CI runner with no display can still prove the published binary renders. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexNet\NexNet.csproj" />
    <ProjectReference Include="..\NexNet.Inspector.Core\NexNet.Inspector.Core.csproj" />
    <ProjectReference Include="..\NexNet.Inspector.Tap\NexNet.Inspector.Tap.csproj" />
  </ItemGroup>

  <!-- Atkinson Hyperlegible Next (UI) and JetBrains Mono NL (data), OFL: only the static weights tokens.json's typography
       names, so the repo stays small. Avalonia 12 cannot instance a variable font's wght axis, hence static files. Each
       family's licence ships beside the exe. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\Atkinson\*.ttf;Assets\Fonts\JetBrainsMono\*.ttf" />
    <None Include="Assets\Fonts\Atkinson\OFL.txt" Link="AtkinsonHyperlegibleNext-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\Fonts\JetBrainsMono\OFL.txt" Link="JetBrainsMonoNL-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The logo is the repo's own (docs/images), linked rather than copied so there is one file to update. -->
  <ItemGroup>
    <AvaloniaResource Include="..\..\docs\images\logo-128.png;..\..\docs\images\logo-256.png" Link="Assets\Logo\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
