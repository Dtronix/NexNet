<!--
  The Compare workspace's bottom panel (PKG compare: 200 px, Field diff with the hex pane at 42 % width, a 1 px
  border.default between them), over CompareWorkspaceViewModel.DetailPanel, which follows the selected entity.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NexNet.Inspector.App.ViewModels"
             xmlns:cmp="using:NexNet.Inspector.App.Views.Compare"
             x:Class="NexNet.Inspector.App.Views.Compare.CompareDetailView"
             x:DataType="vm:CompareDetailViewModel">
  <Grid ColumnDefinitions="58*,Auto,42*">
    <cmp:FieldDiffPane x:Name="FieldDiffView" DataContext="{Binding FieldDiff}" />
    <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.Border.Default}" />
    <cmp:CompareHexPane x:Name="HexView" Grid.Column="2" DataContext="{Binding Hex}" />
  </Grid>
</UserControl>