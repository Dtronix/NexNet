<!--
  The bookmarks dropdown (I44, D4): 400 px, anchored under the title bar's ★ on the menu surface (panel fill,
  border.strong, 8 px corners, shadow.popover), as the session popover. Header: "Bookmarks · 3 of 50" and the
  highlighted action "★ Bookmark current view · Ctrl+Shift+B". Rows (menu-item height): Alt+n, the name, the range in
  mono, the scope badge when the bookmark carries a scope, ✕ (delete). A click (or Enter) on a row jumps to it and closes
  the list; F2 edits its name in place (Enter keeps, Esc cancels), Delete deletes it, Esc closes. Empty, a line says how
  to add one. The footer repeats the keys.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NexNet.Inspector.App.ViewModels"
             x:Class="NexNet.Inspector.App.Views.Shell.BookmarksPopover"
             x:DataType="vm:BookmarksViewModel"
             AutomationProperties.Name="Bookmarks">
  <UserControl.Resources>
    <ControlTheme x:Key="Bookmarks.Item" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="Bookmarks.Row" TargetType="Button">
      <Setter Property="Background" Value="{x:Static Brushes.Transparent}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Height" Value="{DynamicResource Size.MenuItem}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center" />
            <Border Name="PART_FocusRing" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}"
                    BorderBrush="{DynamicResource Brush.Direction.Inbound}" IsVisible="False" IsHitTestVisible="False" />
          </Panel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.State.Selected}" />
      </Style>
      <Style Selector="^.action">
        <Setter Property="Background" Value="{DynamicResource Brush.State.Selected}" />
        <Setter Property="Height" Value="32" />
      </Style>
      <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{x:Static Brushes.Transparent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
      </Style>
    </ControlTheme>
  </UserControl.Resources>

  <Border Width="400" Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Strong}"
          BorderThickness="1" CornerRadius="{DynamicResource Radius.Xl}" BoxShadow="{DynamicResource Shadow.Popover}"
          TextElement.FontFamily="{DynamicResource Font.Ui}" TextElement.FontSize="{DynamicResource FontSize.Body}"
          TextElement.Foreground="{DynamicResource Brush.Text.Primary}">
    <StackPanel Margin="4">
      <TextBlock Name="Header" Margin="8,6,8,4" Text="{Binding HeaderText}" FontWeight="{DynamicResource FontWeight.SemiBold}" />

      <Button Name="AddAction" Theme="{StaticResource Bookmarks.Row}" Classes="action" Command="{Binding AddCommand}"
              ToolTip.Tip="Its window and scope, named by its range until you rename it" ToolTip.ShowOnDisabled="True"
              AutomationProperties.Name="Bookmark current view (Ctrl+Shift+B)">
        <Grid ColumnDefinitions="18,*,Auto">
          <TextBlock Text="★" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent.Trace}" />
          <TextBlock Grid.Column="1" Text="Bookmark current view" VerticalAlignment="Center" FontWeight="{DynamicResource FontWeight.SemiBold}" />
          <TextBlock Grid.Column="2" Text="Ctrl+Shift+B" VerticalAlignment="Center" FontFamily="{DynamicResource Font.Mono}"
                     FontSize="{DynamicResource FontSize.Meta}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
        </Grid>
      </Button>

      <TextBlock Name="EmptyText" Margin="8,8,8,6" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}"
                 FontSize="{DynamicResource FontSize.Data}" Foreground="{DynamicResource Brush.Text.Secondary}"
                 Text="No bookmarks in this recording yet. Ctrl+Shift+B keeps the current view and its scope; Alt+1…9 jump back." />

      <ListBox Name="Rows" Margin="0,4,0,0" ItemsSource="{Binding Items}" ItemContainerTheme="{StaticResource Bookmarks.Item}"
               Background="{x:Static Brushes.Transparent}" BorderThickness="0" Padding="0" MaxHeight="312"
               IsVisible="{Binding HasItems}" AutomationProperties.Name="Bookmarks">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:BookmarkItem">
            <Grid ColumnDefinitions="*,Auto" Height="{DynamicResource Size.MenuItem}">
              <Button Name="BookmarkRow" Theme="{StaticResource Bookmarks.Row}" IsVisible="{Binding !IsEditing}"
                      Command="{Binding #Rows.((vm:BookmarksViewModel)DataContext).JumpCommand}" CommandParameter="{Binding}"
                      AutomationProperties.Name="{Binding AccessibleName}">
                <Grid ColumnDefinitions="44,*,Auto,Auto">
                  <TextBlock Text="{Binding ShortcutText}" VerticalAlignment="Center" FontFamily="{DynamicResource Font.Mono}"
                             FontSize="{DynamicResource FontSize.Meta}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                  <TextBlock Name="BookmarkName" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                  <TextBlock Name="BookmarkRange" Grid.Column="2" Text="{Binding RangeText}" Margin="12,0,0,0" VerticalAlignment="Center"
                             FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource FontSize.Data}"
                             Foreground="{DynamicResource Brush.Text.Secondary}" />
                  <Border Name="ScopeBadge" Grid.Column="3" Margin="8,0,0,0" Padding="5,0" Height="16" VerticalAlignment="Center"
                          IsVisible="{Binding HasScope}" ToolTip.Tip="{Binding ScopeTip}"
                          Background="{DynamicResource Brush.Accent.TraceBand}" BorderBrush="{DynamicResource Brush.Accent.Trace}"
                          BorderThickness="1" CornerRadius="{DynamicResource Radius.Sm}">
                    <TextBlock Text="scope" VerticalAlignment="Center" FontFamily="{DynamicResource Font.Mono}"
                               FontSize="{DynamicResource FontSize.Meta}" Foreground="{DynamicResource Brush.Text.Primary}" />
                  </Border>
                </Grid>
              </Button>
              <TextBox Name="NameEditor" IsVisible="{Binding IsEditing}" Text="{Binding EditText}" Margin="2,1" VerticalAlignment="Center"
                       AutomationProperties.Name="Bookmark name" />
              <Button Name="DeleteButton" Grid.Column="1" Theme="{StaticResource Bookmarks.Row}" Width="26" Padding="0"
                      HorizontalContentAlignment="Center" Content="✕" Foreground="{DynamicResource Brush.Text.Secondary}"
                      Command="{Binding #Rows.((vm:BookmarksViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}"
                      ToolTip.Tip="Delete the bookmark (Delete)" AutomationProperties.Name="Delete bookmark" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Margin="8,6,8,6" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Data}"
                 Foreground="{DynamicResource Brush.Text.Secondary}"
                 Text="Click a bookmark to show its window again (and push its scope) · F2 renames · Delete deletes · Alt+1…9 jump to the first nine. Kept per recording in this app's settings." />
    </StackPanel>
  </Border>
</UserControl>
