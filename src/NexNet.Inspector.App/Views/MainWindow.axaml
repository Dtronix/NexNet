<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NexNet.Inspector.App.ViewModels"
        xmlns:shell="using:NexNet.Inspector.App.Views.Shell"
        xmlns:c="using:NexNet.Inspector.App.Controls"
        xmlns:home="using:NexNet.Inspector.App.Views.Home"
        xmlns:connect="using:NexNet.Inspector.App.Views.Connect"
        x:Class="NexNet.Inspector.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="700"
        WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="36"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Surface.App}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource FontSize.Body}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+K" Command="{Binding ConnectCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
  </Window.KeyBindings>
  <Window.DataTemplates>
    <DataTemplate DataType="vm:ConnectDialogViewModel">
      <connect:ConnectDialog />
    </DataTemplate>
  </Window.DataTemplates>
  <!-- Minimum size from OQ10; below ~1200 px the panes collapse (ShellLayoutPolicy, read from Chrome.Layout). The window
       draws its own title bar: the OS frame with the client area extended under it, or no frame at all on Linux
       (MainWindow.axaml.cs). -->
  <Grid x:Name="Root" RowDefinitions="Auto,*">
    <shell:TitleBar x:Name="TitleBar" DataContext="{Binding Chrome}" />

    <!-- The empty window: hero, action cards, recents; dropping a .nntl on it opens the file. -->
    <Panel Grid.Row="1" IsVisible="{Binding !Documents.HasDocuments}">
      <home:HomeView x:Name="Home" DataContext="{Binding Home}" />
    </Panel>

    <!-- The modal layer below the title bar: scrim and the open dialog (connect, open-recording). -->
    <c:DialogHost x:Name="Dialogs" Grid.Row="1" Dialog="{Binding Dialog}" />
  </Grid>
</Window>
