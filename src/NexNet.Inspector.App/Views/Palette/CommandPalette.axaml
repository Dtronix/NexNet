<!--
  The command palette (SYSTEM.md "command-palette", one-off control): a 600 px panel at the top centre, 56 px below the
  window top, over a scrim at opacity.scrim.palette (a press on it closes the palette). Radius 10, 1 px border.strong,
  shadow.palette.
  - Input row, 40 px: the search lens, the 14 px query, and the scope pills All | Commands | Frames | Entities | Sessions
    (20 px; the selected pill is state.selected). Typing a prefix moves the pill (CommandPaletteViewModel).
  - Results: 10 px capital headings (ENTITIES, FRAMES, COMMANDS, …), then 28 px items with radius 6: the icon column
    (◆ trace, ▼/▲ in their direction colours, a command's glyph), the label and its secondary detail, and the mono
    shortcut at the right ("Enter" on the keyboard's item). The keyboard's item is state.selected with a 1 px
    direction.inbound ring. A virtualized list: a frame query can list hundreds.
  - Footer, 28 px: the key hints, and Esc close at the right.
  Keys (CommandPalette.axaml.cs): ↑↓ PageUp PageDown move, Enter runs, Tab / Shift+Tab switch the scope, Esc closes.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NexNet.Inspector.App.ViewModels"
             xmlns:pal="using:NexNet.Inspector.App.Model.Palette"
             xmlns:c="using:NexNet.Inspector.App.Controls"
             x:Class="NexNet.Inspector.App.Views.Palette.CommandPalette"
             x:DataType="vm:CommandPaletteViewModel"
             AutomationProperties.Name="Command palette">
  <UserControl.Resources>
    <ControlTheme x:Key="PaletteScopeItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            VerticalContentAlignment="Center" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      </Style>
      <Style Selector="^:selected">
        <Setter Property="Background" Value="{DynamicResource Brush.State.Selected}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="PaletteScopes" TargetType="ListBox">
      <Setter Property="SelectionMode" Value="Single,AlwaysSelected" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ItemContainerTheme" Value="{StaticResource PaletteScopeItem}" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="4" />
        </ItemsPanelTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The query: no field chrome of its own, the input row is the field. -->
    <Style Selector="TextBox.palette">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Large}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.palette /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.palette:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.palette:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="TextBlock.palette-heading">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="Margin" Value="14,10,14,4" />
    </Style>

    <Style Selector="Border.palette-item">
      <Setter Property="Height" Value="{DynamicResource Size.PaletteItem}" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Padding" Value="12,0,10,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.palette-item:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
    </Style>
    <Style Selector="Border.palette-item.selected">
      <Setter Property="Background" Value="{DynamicResource Brush.State.Selected}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Direction.Inbound}" />
    </Style>
    <Style Selector="Border.palette-item.disabled">
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Border.palette-item TextBlock.glyph">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Data}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.palette-item TextBlock.glyph.inbound">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Direction.Inbound}" />
    </Style>
    <Style Selector="Border.palette-item TextBlock.glyph.outbound">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Direction.Outbound}" />
    </Style>
    <Style Selector="Border.palette-item.selected TextBlock.glyph.trace">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Trace}" />
    </Style>
    <Style Selector="Border.palette-item TextBlock.shortcut">
      <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Data}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>

    <Style Selector="TextBlock.palette-hint">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Meta}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <Border Name="Scrim" Background="{DynamicResource Brush.Overlay.Scrim}" Opacity="{DynamicResource Opacity.Scrim.Palette}" />

    <Border Name="Surface" Width="600" Margin="0,56,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
            Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1"
            CornerRadius="{DynamicResource Radius.2Xl}" BoxShadow="{DynamicResource Shadow.Palette}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="40" Padding="14,0,10,0"
                BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,0,0,1">
          <DockPanel>
            <Path DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"
                  Data="M 6 0.75 A 5.25 5.25 0 1 1 5.99 0.75 Z M 9.8 9.8 L 13.5 13.5"
                  Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1.5" StrokeLineCap="Round" />
            <ListBox Name="Scopes" DockPanel.Dock="Right" Theme="{StaticResource PaletteScopes}"
                     AutomationProperties.Name="Search in"
                     ItemsSource="{Binding Scope.Labels}" SelectedIndex="{Binding Scope.SelectedIndex}" />
            <TextBox Name="Input" Classes="palette" VerticalAlignment="Center" Margin="0,0,10,0"
                     Text="{Binding Query}" PlaceholderText="Search entities, frames, commands…"
                     AutomationProperties.Name="Command palette query" />
          </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Height="28" Padding="14,0"
                BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,1,0,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Classes="palette-hint" Text="Esc close" />
            <TextBlock Classes="palette-hint" Text="{x:Static vm:CommandPaletteViewModel.Hints}" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>

        <Panel>
          <TextBlock Name="NoMatches" IsVisible="{Binding IsEmpty}" Margin="14,12" Text="No matches"
                     Foreground="{DynamicResource Brush.Text.Tertiary}" />
          <ItemsControl Name="Results" ItemsSource="{Binding Rows}" MaxHeight="440" Margin="0,0,0,6"
                        AutomationProperties.Name="Results">
            <ItemsControl.Template>
              <ControlTemplate>
                <ScrollViewer Name="PART_ScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pal:PaletteRow">
                <Panel>
                  <TextBlock Classes="palette-heading" IsVisible="{Binding IsHeader}"
                             Text="{Binding Label, Converter={x:Static c:MenuText.Upper}}" />
                  <Border Classes="palette-item" Classes.selected="{Binding IsSelected}" Classes.disabled="{Binding !IsEnabled}"
                          IsVisible="{Binding IsItem}" AutomationProperties.Name="{Binding AccessibleName}">
                    <Grid ColumnDefinitions="24,*,Auto,Auto">
                      <TextBlock Classes="glyph" Classes.inbound="{Binding IsInbound}" Classes.outbound="{Binding IsOutbound}"
                                 Classes.trace="{Binding IsTraceGlyph}" Text="{Binding GlyphText}" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource FontSize.Body}">
                        <Run Text="{Binding Label}" Foreground="{DynamicResource Brush.Text.Primary}" />
                        <Run Text=" " />
                        <Run Text="{Binding Detail}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                      </TextBlock>
                      <c:PipeChip Grid.Column="2" Kind="{Binding PipeKind}" IsVisible="{Binding HasPipeChip}" Margin="6,0,0,0"
                                  VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Classes="shortcut" Text="{Binding ShortcutText}" />
                    </Grid>
                  </Border>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Panel>
      </DockPanel>
    </Border>
  </Panel>
</UserControl>
