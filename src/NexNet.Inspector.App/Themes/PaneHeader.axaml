<!--
  The pane header (controls/pane-header): a 24 px strip on surface.chrome with a border.default bottom line, padded 0 6.
  Left: 20 px view tabs (padding 0 9, radius 4, 11.5 px; secondary text on the chrome fill; the selected tab raised with
  600 weight; hover raised with primary text; keyboard focus a 2 px direction.inbound outline), or in the titled variant
  a bold title and a secondary subtitle. Right, 2 px apart: the view's controls (11 px secondary, 6 px before the badge),
  the link badge (11 px link icon + 10.5 px "synced" in status.ok, or "unsynced" in tertiary), the inspector's frame id
  (mono 11 px secondary) and the split button (the Button "split" class: ◫ Single / ◫ Split on the left pane, ✕ on the
  right one).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:NexNet.Inspector.App.Controls">

  <!-- The link icon of the synced badge, in its 16 px view box (stroked 1.6, so it takes the badge's colour). -->
  <StreamGeometry x:Key="Glyph.Pane.Link">M6.5,9.5 L9.5,6.5 M5,8 L3.5,9.5 A2.1,2.1 0 0 0 6.5,12.5 L8,11 M8,5 L9.5,3.5 A2.1,2.1 0 0 1 12.5,6.5 L11,8</StreamGeometry>
  <!-- ◫: a window split in two, drawn so it does not depend on a font having the glyph. -->
  <StreamGeometry x:Key="Glyph.Pane.Split">M0.5,0.5 H10.5 V10.5 H0.5 Z M5.5,0.5 V10.5</StreamGeometry>

  <ControlTheme x:Key="PaneTab" TargetType="ListBoxItem">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Chrome}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!-- outline: 2px, drawn just outside the tab. -->
          <Border Name="PART_FocusRing" Margin="-2" BorderThickness="2" CornerRadius="6"
                  BorderBrush="{DynamicResource Brush.Direction.Inbound}" IsVisible="False" />
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            VerticalContentAlignment="Center" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <!-- The tab row: a tablist; Left/Right move between views. -->
  <ControlTheme x:Key="PaneTabs" TargetType="ListBox">
    <Setter Property="SelectionMode" Value="Single,AlwaysSelected" />
    <Setter Property="Background" Value="{x:Null}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource PaneTab}" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:PaneHeader}" TargetType="c:PaneHeader">
    <Setter Property="Height" Value="{DynamicResource Size.PaneHeader}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Chrome}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}">
          <DockPanel>
            <StackPanel Name="PART_Right" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <ContentPresenter Name="PART_ViewControls" Content="{TemplateBinding ViewControls}" Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSize.Data}"
                                Foreground="{DynamicResource Brush.Text.Secondary}"
                                IsVisible="{TemplateBinding ViewControls, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <StackPanel Name="PART_Synced" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" IsVisible="False"
                          AutomationProperties.Name="Synced with the timeline">
                <Viewbox Width="11" Height="11" VerticalAlignment="Center">
                  <Canvas Width="16" Height="16">
                    <Path Data="{StaticResource Glyph.Pane.Link}" StrokeThickness="1.6" StrokeLineCap="Round"
                          Stroke="{DynamicResource Brush.Status.Ok}" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="synced" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Meta}"
                           Foreground="{DynamicResource Brush.Status.Ok}" />
              </StackPanel>
              <TextBlock Name="PART_Unsynced" Text="unsynced" VerticalAlignment="Center" IsVisible="False"
                         FontSize="{DynamicResource FontSize.Meta}" Foreground="{DynamicResource Brush.Text.Tertiary}"
                         AutomationProperties.Name="Not synced with the timeline" />
              <TextBlock Name="PART_Trailing" Text="{TemplateBinding Trailing}" VerticalAlignment="Center" Margin="4,0,4,0"
                         FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource FontSize.Data}"
                         Foreground="{DynamicResource Brush.Text.Secondary}"
                         IsVisible="{TemplateBinding Trailing, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <Button Name="PART_Split" Classes="split" Margin="6,0,0,0" IsVisible="False"
                      Command="{TemplateBinding SplitCommand}" IsEnabled="{TemplateBinding CanSplit}"
                      AutomationProperties.Name="Toggle split view">
                <Panel>
                  <StackPanel Name="PART_SplitLabel" Orientation="Horizontal" Spacing="4">
                    <Path Data="{StaticResource Glyph.Pane.Split}" StrokeThickness="1" VerticalAlignment="Center"
                          Stroke="{Binding $parent[Button].Foreground}" />
                    <TextBlock Name="PART_SplitText" Text="Single" VerticalAlignment="Center" />
                  </StackPanel>
                  <PathIcon Name="PART_CloseGlyph" Width="8" Height="8" IsVisible="False"
                            Data="{StaticResource Glyph.Caption.Close}" />
                </Panel>
              </Button>
            </StackPanel>

            <ListBox Name="PART_Tabs" Theme="{StaticResource PaneTabs}"
                     ItemsSource="{TemplateBinding Tabs}"
                     SelectedIndex="{Binding SelectedIndex, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                     AutomationProperties.Name="Views" />
            <StackPanel Name="PART_Title" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="False">
              <TextBlock Text="{TemplateBinding Title}" FontWeight="Bold" VerticalAlignment="Center" />
              <TextBlock Text="{TemplateBinding Subtitle}" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Data}"
                         Foreground="{DynamicResource Brush.Text.Secondary}" />
            </StackPanel>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:titled /template/ ListBox#PART_Tabs">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:titled /template/ StackPanel#PART_Title">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:synced /template/ StackPanel#PART_Synced">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:unsynced /template/ TextBlock#PART_Unsynced">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:single /template/ Button#PART_Split, ^:split /template/ Button#PART_Split, ^:close /template/ Button#PART_Split">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:split /template/ TextBlock#PART_SplitText">
      <Setter Property="Text" Value="Split" />
    </Style>
    <Style Selector="^:close /template/ Button#PART_Split">
      <Setter Property="Width" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="AutomationProperties.Name" Value="Close pane" />
    </Style>
    <Style Selector="^:close /template/ StackPanel#PART_SplitLabel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:close /template/ PathIcon#PART_CloseGlyph">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
