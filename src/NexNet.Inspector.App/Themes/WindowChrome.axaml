<!--
  The window chrome's themes (controls/window-title-bar, controls/document-tab).
  ChromeButton: the title bar's borderless buttons (logo, +): transparent until hovered (surface.raised); the logo stays
  raised while its menu is open (pressed). ChromeGroup: a 24 px bordered group (Connect…, the time window).
  DocumentTabs / DocumentTab: the tab strip, a TabStrip whose items are 24 px tabs, 8 px padding, 5 px radius, 6 px apart;
  hover = raised fill and primary text, selected = panel fill, a 1 px border.default ring and 600 weight, keyboard focus
  = a 2 px direction.inbound ring 1 px outside (OQ1). Colour changes are instant (no brush transitions: tokens.json).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ControlTheme x:Key="ChromeButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_FocusRing" Margin="-3" BorderThickness="2" CornerRadius="8"
                  BorderBrush="{DynamicResource Brush.Direction.Inbound}" IsVisible="False" />
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- The tab strip's +: 14 px, a little wider than tall. -->
    <Style Selector="^.add">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Large}" />
      <Setter Property="Height" Value="{DynamicResource Size.HeaderControl}" />
    </Style>
    <!-- A tab's close glyph: 11 px tertiary, no fill of its own (the tab's hover shows). -->
    <Style Selector="^.tabClose">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Data}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
    </Style>
    <Style Selector="^.tabClose:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
  </ControlTheme>

  <!-- A 24 px group with a 1 px border: the Connect… status and the time window. -->
  <ControlTheme x:Key="ChromeGroup" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
    <Setter Property="Height" Value="{DynamicResource Size.HeaderControl}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_FocusRing" Margin="-3" BorderThickness="2" CornerRadius="8"
                  BorderBrush="{DynamicResource Brush.Direction.Inbound}" IsVisible="False" />
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  ClipToBounds="True">
            <ContentPresenter Name="PART_ContentPresenter"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              VerticalContentAlignment="Center" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="DocumentTab" TargetType="TabStripItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    <Setter Property="Height" Value="{DynamicResource Size.HeaderControl}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!-- box-shadow: 0 0 0 1px border.default: the selected tab's ring, just outside it. -->
          <Border Name="PART_SelectedRing" Margin="-1" BorderThickness="1" CornerRadius="6"
                  BorderBrush="{DynamicResource Brush.Border.Default}" IsVisible="False" />
          <Border Name="PART_FocusRing" Margin="-3" BorderThickness="2" CornerRadius="8"
                  BorderBrush="{DynamicResource Brush.Direction.Inbound}" IsVisible="False" />
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            VerticalContentAlignment="Center" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_SelectedRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="DocumentTabs" TargetType="TabStrip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource DocumentTab}" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="6" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
