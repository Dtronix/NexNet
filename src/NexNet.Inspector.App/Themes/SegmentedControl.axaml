<!--
  The segmented control (controls/segmented-control): a ListBox with Theme="{StaticResource Segmented}", one item per
  option of an enum (ItemsSource/SelectedIndex bound to an EnumChoice; labels come from the enum, never compared as
  strings). Sizes by class: md (default, 24 px: title bar), sm (18 px: pane headers, the menu's theme row), dialog
  (28 px, equal-width segments). The selected segment is a panel-filled chip with a 1 px ring and 600 weight, so the
  choice does not rest on colour alone. Left/Right move the selection, Home/End jump (ListBox keyboard handling).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ControlTheme x:Key="SegmentedItem" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <!-- The selected and focus rings are drawn outside the segment. -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!-- box-shadow: 0 0 0 1px border.default: a ring just outside the selected chip. -->
          <Border Name="PART_SelectedRing" Margin="-1" BorderThickness="1" CornerRadius="5"
                  BorderBrush="{DynamicResource Brush.Border.Default}" IsVisible="False" />
          <!-- The keyboard ring: 2 px, 1 px outside the chip. -->
          <Border Name="PART_FocusRing" Margin="-3" BorderThickness="2" CornerRadius="7"
                  BorderBrush="{DynamicResource Brush.Direction.Inbound}" IsVisible="False" />
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Chrome}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_SelectedRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:selected:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="SegmentedItemSm" TargetType="ListBoxItem" BasedOn="{StaticResource SegmentedItem}">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Data}" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
    <Style Selector="^ /template/ Border#PART_SelectedRing">
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="^ /template/ Border#PART_FocusRing">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="Segmented" TargetType="ListBox">
    <Setter Property="SelectionMode" Value="Single,AlwaysSelected" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Height" Value="{DynamicResource Size.HeaderControl}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource SegmentedItem}" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <!-- No ClipToBounds: the selected chip's rings reach a pixel or three past it. -->
        <Border Name="PART_Track"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.sm">
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="ItemContainerTheme" Value="{StaticResource SegmentedItemSm}" />
    </Style>
    <!-- The dialog row (connect: Drop | Block): 28 px, the segments share the width equally. -->
    <Style Selector="^.dialog">
      <Setter Property="Height" Value="{DynamicResource Size.Input}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
