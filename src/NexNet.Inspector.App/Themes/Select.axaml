<!--
  Select (controls/select): the app's ComboBox theme. A 28 px raised field with the value and a tertiary caret; the
  open list sits on the menu surface (panel fill, strong border, 8 px radius, menu shadow) with 26 px items and a check
  on the current one. Class sm is the text-only pane-header select ("Filter ▾"): 11 px secondary text, no field.
  Hover = strong border; keyboard focus or open = 1.5 px direction.inbound border; disabled = 55 % opacity. Popup
  placement (below, flipping above at the window edge) is the ComboBox's own. A full theme rather than Fluent's re-keyed
  because the caret glyph, the check and the sm variant change the template, not just its colours.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    <Setter Property="Height" Value="{DynamicResource Size.MenuItem}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Background"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Drawn, not a ✓ character: the UI font has none, and a fallback font's would not match. -->
            <Path Name="PART_Check" Data="M0.5,4.5 L3.5,7.5 L9.5,1" Width="10" Height="9" Margin="0,0,5,0"
                  StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round"
                  Stroke="{TemplateBinding Foreground}" VerticalAlignment="Center" IsVisible="False" />
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover, ^:focus-visible">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource Brush.State.Selected}" />
    </Style>
    <Style Selector="^:selected /template/ Path#PART_Check">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
    <Setter Property="Height" Value="{DynamicResource Size.Input}" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MaxDropDownHeight" Value="504" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource Brush.Text.Tertiary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <VirtualizingStackPanel />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Field"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="*,Auto">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                VerticalAlignment="Center" />
              <TextBlock Name="PART_Placeholder" Text="{TemplateBinding PlaceholderText}"
                         Foreground="{TemplateBinding PlaceholderForeground}" VerticalAlignment="Center"
                         IsVisible="{TemplateBinding SelectionBoxItem, Converter={x:Static ObjectConverters.IsNull}}" />
              <!-- The ▾ caret, drawn so it does not depend on a fallback font. -->
              <Path Name="PART_Caret" Grid.Column="1" Data="M0,0 H7 L3.5,4.5 Z" Margin="10,1,0,0" VerticalAlignment="Center"
                    Fill="{DynamicResource Brush.Text.Tertiary}" />
            </Grid>
          </Border>
          <Popup Name="PART_Popup"
                 WindowManagerAddShadowHint="False"
                 IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                 MinWidth="160"
                 MaxHeight="{TemplateBinding MaxDropDownHeight}"
                 PlacementTarget="PART_Field"
                 Placement="BottomEdgeAlignedLeft"
                 VerticalOffset="4"
                 IsLightDismissEnabled="True">
            <Border Name="PART_MenuSurface"
                    Background="{DynamicResource Brush.Surface.Panel}"
                    BorderBrush="{DynamicResource Brush.Border.Strong}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Xl}"
                    BoxShadow="{DynamicResource Shadow.Menu}"
                    Padding="4">
              <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                            VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
    </Style>
    <Style Selector="^:focus-visible, ^:dropdownopen">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Direction.Inbound}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <!-- The pane-header select: text and caret only, at the header's 11 px. -->
    <Style Selector="^.sm">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Data}" />
      <Setter Property="Height" Value="20" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
    </Style>
    <Style Selector="^.sm /template/ Path#PART_Caret">
      <Setter Property="Margin" Value="4,1,0,0" />
      <Setter Property="Fill" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>
    <Style Selector="^.sm:focus-visible, ^.sm:dropdownopen">
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
