<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NexNet.Inspector.App.App"
             RequestedThemeVariant="Default">
  <!-- Order matters: each later include overrides the keys and control themes of the ones before it. -->
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <!-- The design tokens and the app's control themes. -->
    <StyleInclude Source="/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
