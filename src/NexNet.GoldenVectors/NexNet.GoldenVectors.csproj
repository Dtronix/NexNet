<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Golden vector tool (H03): generates tests/golden/*.jsonl, the language-neutral MessagePack test vectors every NexNet
    runtime replays (format: tests/golden/README.md), and the fuzz seed corpus src/NexNet.Fuzz/Corpus/golden.hex.
    Run it with the command in tests/golden/README.md.

    The value schemas of the interop type zoo come from the generator's C# test scaffolding of the interop nexus
    (NexusTestScaffolding), so they match the generator IR. Test infrastructure; not packaged.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexNet\NexNet.csproj" />
    <ProjectReference Include="..\NexNet.Interop.Abstractions\NexNet.Interop.Abstractions.csproj" />
    <ProjectReference Include="..\NexNet.TestNexus\NexNet.TestNexus.csproj" />
    <ProjectReference Include="..\NexNet.Generator\NexNet.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

</Project>
