<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared test nexuses (H02): the nexus interfaces and classes of the integration tests, and the interop type zoo used by
    the cross-language harness. Test infrastructure; not packaged.

    The interop server nexuses, the basic ServerNexus (IServerNexus/IClientNexus), AuthServerNexus and the versioned
    server nexuses (V1, V1.1, V2) opt in to Java and JavaScript (Targets), so the generator writes their clients to
    artifacts/interop/<lang>/generated (gitignored) through the NexNet.Generator props and targets imported below.
  -->
  <Import Project="..\NexNet.Generator\buildTransitive\NexNet.Generator.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>

    <NexNetInteropArtifactsDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'artifacts', 'interop'))</NexNetInteropArtifactsDir>
  </PropertyGroup>

  <!--
    Java (K12): written as an item so it carries EmitTestScaffolding, the scriptable client nexuses, codecs and
    invokeByName of the JVM interop host (clients/java/interop-host compiles this directory). The package stays
    com.dtronix.nexnet.testnexus: the zoo's NexusTargetFormatter mapping (InteropTypes.cs) names a class in it.
  -->
  <ItemGroup>
    <NexNetTarget Include="java" OutputDir="$(NexNetInteropArtifactsDir)java/generated" Package="com.dtronix.nexnet.testnexus"
                  EmitTestScaffolding="true" />
  </ItemGroup>

  <ItemGroup>
    <!--
      JavaScript (J12): the clients and the test scaffolding (J11) of the Node and browser language hosts. npm run
      build:interop-host (clients/js) copies them into the hosts; they import the runtime as @dtronix/nexnet.
    -->
    <NexNetTarget Include="javascript" OutputDir="$(NexNetInteropArtifactsDir)js/generated" EmitTestScaffolding="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NexNet.IntegrationTests" />
    <InternalsVisibleTo Include="NexNet.Interop" />
    <InternalsVisibleTo Include="NexNet.GoldenVectors" />
    <InternalsVisibleTo Include="NexNet.Serialization.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexNet\NexNet.csproj" />
    <ProjectReference Include="..\NexNet.InteropServer\NexNet.InteropServer.csproj" />
    <ProjectReference Include="..\NexNet.Generator\NexNet.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

  <Import Project="..\NexNet.Generator\buildTransitive\NexNet.Generator.targets" />

</Project>
