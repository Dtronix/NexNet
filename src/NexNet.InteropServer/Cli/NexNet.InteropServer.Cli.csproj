<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Console entry point: starts a dedicated interop server with the interop test nexus (src/NexNet.TestNexus), for manual
    debugging and the nightly Android emulator smoke test. Building it builds TestNexus, which writes the Java client the
    smoke test compiles to artifacts/interop/java/generated.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexNet.InteropServer.csproj" />
    <ProjectReference Include="..\..\NexNet.TestNexus\NexNet.TestNexus.csproj" />
  </ItemGroup>

</Project>
