<Project Sdk="Microsoft.NET.Sdk">
  <!-- The app's tests: settings, theme, headless launch and self-check, and the opt-in screen capture harness
       (Capture/, only when NEXNET_INSPECTOR_CAPTURE_DIR is set). Rendering tests share one Avalonia headless session
       drawn by Skia (HeadlessSession). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" Version="$(TUnitVersion)" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NexNet.Inspector.App\NexNet.Inspector.App.csproj" />
    <ProjectReference Include="..\NexNet.Inspector.Tap\NexNet.Inspector.Tap.csproj" />
    <!-- The Chat sample: the tapped in-process server the live attach tests inspect, and its schema. -->
    <ProjectReference Include="..\NexNet.Inspector.Sample\NexNet.Inspector.Sample.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The checked-in recordings of the inspector tests, opened by the document tests. -->
    <None Include="..\NexNet.Inspector.Tests\Fixtures\*.nntl" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
