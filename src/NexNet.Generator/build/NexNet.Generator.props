<Project>
  <!--
    NexNet multi-language targets (Java, JavaScript). See docs/articles/multi-language-clients.md.

    Shorthand properties, each converted to a NexNetTarget item:
      NexNetJavaOutputDir, NexNetJavaPackage                  -> <NexNetTarget Include="java" OutputDir="..." Package="..." />
      NexNetJavaScriptOutputDir, NexNetJavaScriptModuleName   -> <NexNetTarget Include="javascript" OutputDir="..." ModuleName="..." />
      NexNetJavaEmitRuntime, NexNetJavaNullness               -> EmitRuntime="...", Nullness="..." on the java item
      NexNetJavaEmitRuntimeModules                            -> EmitRuntimeModules="..." on the java item (e.g. kotlin;okhttp)
      NexNetJavaScriptEmitRuntime, NexNetJavaScriptRuntimeImport -> EmitRuntime="...", RuntimeImport="..." on the javascript item

    The client runtime is emitted beside the generated code unless EmitRuntime="false" (D31,
    docs/internals/generator-emitted-runtime.md). The optional Java modules (android, kotlin, micrometer, okhttp) are
    emitted only when EmitRuntimeModules lists them; each needs its own third-party libraries.

    Items are evaluated after every property, so these conditions see the values set in the project file.
  -->
  <PropertyGroup>
    <_NexNetGeneratorPropsImported>true</_NexNetGeneratorPropsImported>
  </PropertyGroup>

  <ItemGroup>
    <NexNetTarget Include="java" Condition="'$(NexNetJavaOutputDir)' != ''"
                  OutputDir="$(NexNetJavaOutputDir)" Package="$(NexNetJavaPackage)"
                  EmitRuntime="$(NexNetJavaEmitRuntime)" Nullness="$(NexNetJavaNullness)"
                  EmitRuntimeModules="$(NexNetJavaEmitRuntimeModules)" />
    <NexNetTarget Include="javascript" Condition="'$(NexNetJavaScriptOutputDir)' != ''"
                  OutputDir="$(NexNetJavaScriptOutputDir)" ModuleName="$(NexNetJavaScriptModuleName)"
                  EmitRuntime="$(NexNetJavaScriptEmitRuntime)" RuntimeImport="$(NexNetJavaScriptRuntimeImport)" />
  </ItemGroup>
</Project>
