<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../NexNet.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalyzerLanguage>cs</AnalyzerLanguage>
    <Nullable>enable</Nullable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackBuildOutputs</TargetsForTfmSpecificContentInPackage>
    <IsRoslynComponent>true</IsRoslynComponent>
    <Description>Source Generator to create hubs and proxies for NexNet clients and servers.</Description>
    <Version>0.21.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NexNet.Generator.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <!-- MSBuild files of the multi-language targets (bundle unpack). NexNet.Generator.Tasks.cs is compiled by MSBuild's
       RoslynCodeTaskFactory in the consuming build, not into the generator. -->
  <ItemGroup>
    <Compile Remove="build/**;buildTransitive/**" />
    <None Remove="build/**;buildTransitive/**" />
    <None Include="build/**" Pack="true" PackagePath="build/" />
    <None Include="buildTransitive/**" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

  <!--
    The client runtimes the generator emits beside the Java/JavaScript code (D31, docs/internals/generator-emitted-runtime.md).
    Checked-in sources only: no npm or Gradle runs here (D27). Read by Runtime/EmbeddedRuntime.cs.
  -->
  <PropertyGroup>
    <_NexNetRepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</_NexNetRepoRoot>
    <_NexNetJsRuntimeDir>$(_NexNetRepoRoot)clients/js/packages/nexnet/src/</_NexNetJsRuntimeDir>
    <_NexNetJsTypesDir>$(_NexNetRepoRoot)clients/js/packages/nexnet/types/</_NexNetJsTypesDir>
    <_NexNetJavaRuntimeDir>$(_NexNetRepoRoot)clients/java/nexnet-client/src/main/java/</_NexNetJavaRuntimeDir>
    <_NexNetJavaModulesDir>$(_NexNetRepoRoot)clients/java/</_NexNetJavaModulesDir>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(_NexNetJsRuntimeDir)**/*.js" LogicalName="NexNet.Runtime/javascript/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
    <!-- The committed tsc declarations (J27), emitted beside the .js they describe. -->
    <EmbeddedResource Include="$(_NexNetJsTypesDir)**/*.d.ts" LogicalName="NexNet.Runtime/javascript/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="$(_NexNetJavaRuntimeDir)**/*.java" LogicalName="NexNet.Runtime/java/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="$(_NexNetRepoRoot)LICENSE" LogicalName="NexNet.Runtime/LICENSE" WithCulture="false" />
    <!-- The optional Java modules (K13), emitted only when listed in EmitRuntimeModules (G10). -->
    <EmbeddedResource Include="$(_NexNetJavaModulesDir)nexnet-client-android/src/main/java/**/*.java" LogicalName="NexNet.Runtime/java-android/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="$(_NexNetJavaModulesDir)nexnet-client-kotlin/src/main/kotlin/**/*.kt" LogicalName="NexNet.Runtime/java-kotlin/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="$(_NexNetJavaModulesDir)nexnet-client-micrometer/src/main/java/**/*.java" LogicalName="NexNet.Runtime/java-micrometer/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="$(_NexNetJavaModulesDir)nexnet-client-okhttp/src/main/java/**/*.java" LogicalName="NexNet.Runtime/java-okhttp/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
  <Target Name="_NexNetCheckRuntimeSources" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(_NexNetJsRuntimeDir)index.js') or !Exists('$(_NexNetJsTypesDir)index.d.ts') or !Exists('$(_NexNetJavaRuntimeDir)com/dtronix/nexnet/NexusRuntime.java') or !Exists('$(_NexNetRepoRoot)LICENSE')
                      or !Exists('$(_NexNetJavaModulesDir)nexnet-client-android/src/main/java/com/dtronix/nexnet/android/NexusAndroid.java')
                      or !Exists('$(_NexNetJavaModulesDir)nexnet-client-kotlin/src/main/kotlin/com/dtronix/nexnet/kotlin/NexusCoroutines.kt')
                      or !Exists('$(_NexNetJavaModulesDir)nexnet-client-micrometer/src/main/java/com/dtronix/nexnet/micrometer/NexusMicrometerBinder.java')
                      or !Exists('$(_NexNetJavaModulesDir)nexnet-client-okhttp/src/main/java/com/dtronix/nexnet/okhttp/OkHttpWebSocketConnector.java')"
           Text="NexNet.Generator embeds the client runtimes from clients/js and clients/java (D31), which are missing under '$(_NexNetRepoRoot)'." />
  </Target>

  <!-- for nuget publish -->
  <Target Name="PackBuildOutputs" DependsOnTargets="SatelliteDllsProjectOutputGroup;DebugSymbolsProjectOutputGroup">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetDir)\*.dll" PackagePath="analyzers\dotnet\cs" />
      <TfmSpecificPackageFile Include="@(SatelliteDllsProjectOutputGroupOutput->'%(FinalOutputPath)')" PackagePath="analyzers\dotnet\cs\%(SatelliteDllsProjectOutputGroupOutput.Culture)\" />
    </ItemGroup>
  </Target>
</Project>
