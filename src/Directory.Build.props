<Project>
  <!-- Every warning is an error, including NuGet audit advisories (NU1901-NU1904). Do not add NoWarn or
       WarningsNotAsErrors to get a build through; fix the cause. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- Central TUnit version for every test project. Pin a release that is at least two weeks old. -->
  <PropertyGroup>
    <TUnitVersion>1.80.0</TUnitVersion>
  </PropertyGroup>
</Project>
